#!/bin/sh
# =============================================================================
# .githooks/post-checkout — put the editor's project files back after a checkout
# =============================================================================
# Enable once per clone, with the rest of this directory:
#
#     git config core.hooksPath .githooks
#
# `.idea/vcs.xml` and `.idea/php.xml` are the editor's own files, and it rewrites them: every git
# repository it can see under `build/` — the scratch copies a killed `verify.py --selftest` leaves
# behind — becomes a `<mapping>` line in the first, and the second picks up whichever interpreter,
# tool path and vendor includes this machine had when it last read them. What the repository carries
# is the template of each — `.githooks/vcs.xml.template` and `.githooks/php.xml.template` — and
# `.githooks/jb-vcs.sh` and `.githooks/jb-php.sh` write the editor's copies back from them. This hook
# is when that happens: a checkout is the moment the tree changes underneath an editor that is
# already open.
#
# The three arguments git passes — the previous HEAD, the new one, and whether this was a branch
# checkout — are not read. The renders are the same either way, so a checkout that moved no file
# still costs one copy of each template.
#
# It never fails a checkout and it says nothing. Git ignores a post-checkout's exit status, so a
# refusal here would be a line nobody acts on, and a clone with no `.idea/` has nothing to put back —
# that is the case this skips rather than creates.
# =============================================================================

set -u

root="$(git rev-parse --show-toplevel 2>/dev/null)" || exit 0
cd "$root" || exit 0

[ -d "$root/.idea" ] || exit 0
command -v bash >/dev/null 2>&1 || exit 0

# Quietly, because the files being right is the whole of what this hook is for, and a checkout is not
# the place to report that they already were. Each renderer is asked for on its own: a tree that
# carries one of them and not the other still gets the one it has.
#
# The scripts are named relatively, though this hook has the absolute root in `$root`: the `bash`
# that answers `command -v bash` need not be the shell running this hook. On a Windows host it can be
# WSL's, which reads this checkout only through `/mnt`, and a path that starts with a drive letter is
# then a file that does not exist — the call failed silently here, and a relative path is the one
# every shell agrees on once the directory is set.
if [ -f "$root/.githooks/jb-vcs.sh" ]; then
    bash .githooks/jb-vcs.sh >/dev/null 2>&1 || true
fi

if [ -f "$root/.githooks/jb-php.sh" ]; then
    bash .githooks/jb-php.sh >/dev/null 2>&1 || true
fi

exit 0
