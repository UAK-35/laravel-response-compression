#!/bin/sh
# =============================================================================
# .githooks/pre-commit — the part of the gate a commit must not break
# =============================================================================
# Enable once per clone:
#
#     git config core.hooksPath .githooks
#
# Then every commit runs `bin/checks.php --staged`, under the interpreter resolved below,
# which checks the staged files for PHP syntax, code style, and broken links between the
# docs — the three things a commit can break on its own. `composer checks` stays the whole
# gate; this is the same tools, earlier and narrower.
#
# Bypass one commit with `git commit --no-verify`.
#
# Which interpreter, and what "which" means, is not decided here: `.agents/php-bin.sh`
# is the one place in this checkout that answers it, and this hook asks like everything
# else does. It used to climb the ladder itself - the environment, then the machine file
# through the renderer, then `git config`, then PATH - which is the same four answers a
# second time, and a second copy of an answer is what this package writes guards about.
# The ladder, the order and the reason for it are in that file's header.
#
# What stays here is the part that is about committing rather than about PHP: the hook
# skips rather than blocking when no interpreter can be found, because a machine without
# PHP must not become a machine that cannot commit, and it says so when a fallback is
# what answered instead of letting the difference pass quietly.
# =============================================================================

set -u

root="$(git rev-parse --show-toplevel 2>/dev/null)" || exit 0
cd "$root" || exit 0

if [ ! -f bin/checks.php ]; then
    echo "pre-commit: bin/checks.php is missing, so the staged checks were skipped." >&2
    exit 0
fi

# The interpreter, from the one place that decides it. Its own refusal names the two ways to
# give this machine one, so the line here is about the commit rather than about the reason: a
# hook that repeated them would be that second copy again.
if [ ! -f .agents/php-bin.sh ]; then
    echo "pre-commit: .agents/php-bin.sh is missing, so the staged checks were skipped." >&2
    exit 0
fi

php_bin="$(sh .agents/php-bin.sh)"
php_from="$(sh .agents/php-bin.sh --why 2>/dev/null || true)"

if [ -z "$php_bin" ]; then
    echo "pre-commit: no PHP interpreter was resolved, so the staged checks were skipped." >&2
    echo "  (the resolver above is .agents/php-bin.sh; sh .agents/php-bin.sh --show says what it found)" >&2
    exit 0
fi

# The difference is worth one line: the same commit checked under two interpreters is the failure
# this file's first paragraph is about, and it is invisible unless it is said.
if [ "$php_from" != ".agents/machine.local.json" ] && [ "$php_from" != "the environment" ]; then
    echo "pre-commit: PHP came from $php_from, and .agents/machine.local.json is the file that names it." >&2
    echo "  write it with: python .agents/render_local.py --init" >&2
fi

# The agentic layer, when this commit is about it: AGENTS.md, the skills, the pointer files, or the
# checks in .agents/. It runs first and on its own, because it is about the commit's own contents and
# not about the package - `bin/checks.php --staged` judges the package below.
#
# `--layer` is the subset with no PHP in it: this directory's own readings, a second or two. The
# full run (`python .agents/verify.py`) also asks every tool and process the package needs to work,
# runs the two path guards and runs the gate - which is the wrong thing to do again on the way
# through a commit that is already running two of those three.
#
# Same rule as the interpreter above: a machine without Python loses this check rather than the
# commit, and a finding is printed by the check itself before this says anything.
agentic_staged="$(git diff --cached --name-only | grep -E '^(AGENTS\.md|CLAUDE\.md|GEMINI\.md|\.agents/|\.skills/|\.trae/|\.cursor/|\.continue/|\.junie/|\.kiro/|\.windsurf/|\.github/copilot-instructions\.md)' || true)"

if [ -n "$agentic_staged" ] && [ -f .agents/verify.py ]; then
    python_bin=""

    for candidate in python python3 py; do
        if command -v "$candidate" >/dev/null 2>&1; then
            python_bin="$candidate"
            break
        fi
    done

    if [ -z "$python_bin" ]; then
        echo "pre-commit: no Python found, so the agentic checks were skipped." >&2
    elif ! "$python_bin" .agents/verify.py --layer; then
        echo "" >&2
        echo "pre-commit: the commit was stopped by the agentic checks above." >&2
        echo "  fix them, or bypass this commit with: git commit --no-verify" >&2
        exit 1
    fi
fi

if "$php_bin" bin/checks.php --staged; then
    exit 0
fi

echo "" >&2
echo "pre-commit: the commit was stopped by the checks above." >&2
echo "  fix them, or bypass this commit with: git commit --no-verify" >&2
exit 1
